# Next.js — copy to .env.local and replace these placeholders.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key
CLERK_SECRET_KEY=your-clerk-secret-key

# Convex — set separately using `npx convex env set` (not Next.js env).
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer.clerk.accounts.dev
ADMIN_EMAILS=admin@example.invalid
N8N_NOTIFY_WEBHOOK_URL=https://your-n8n-host.example.invalid/webhook/lendloop-notify
N8N_WEBHOOK_SECRET=replace-with-a-unique-random-secret
CONVEX_INBOUND_SECRET=replace-with-a-different-random-secret

# n8n — copy the needed variables to n8n/.env for Docker Compose.
CONVEX_SITE_URL=https://your-deployment.convex.site
N8N_ENCRYPTION_KEY=replace-with-a-persistent-random-encryption-key
# Optional: public base URL for an HTTPS tunnel/host; include the trailing slash.
N8N_PUBLIC_URL=https://your-n8n-host.example.invalid/
